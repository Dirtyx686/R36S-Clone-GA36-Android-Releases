<manifest version="1.0" type="device">
    <!-- Actual standard media.codec service registers these interfaces.
         Software codecs are supplied by the existing upstream codec stack. -->
    <hal format="hidl">
        <name>android.hardware.media.omx</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface><name>IOmx</name><instance>default</instance></interface>
        <interface><name>IOmxStore</name><instance>default</instance></interface>
    </hal>
</manifest>
