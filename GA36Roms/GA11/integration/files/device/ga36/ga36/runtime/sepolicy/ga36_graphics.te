# Retained gralloc0 allocates framebuffer buffers in the allocator service.
# GPU/app access stays under the standard gpu_device and ion_device policies.
allow hal_graphics_allocator_default graphics_device:dir search;
allow hal_graphics_allocator_default graphics_device:chr_file rw_file_perms;

# Legacy gralloc reads MemTotal when choosing its allocation strategy.
allow { hal_graphics_allocator_default hal_graphics_composer_default } proc_meminfo:file r_file_perms;
# Retained gralloc links libbinder and opens the standard vendor binder.
vndbinder_use(hal_graphics_composer_default)
