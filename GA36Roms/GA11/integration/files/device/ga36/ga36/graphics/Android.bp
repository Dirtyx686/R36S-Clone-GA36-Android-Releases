// GA36 legacy Mali r4p0 imported with ELF checks; hardware operation still needs device proof.
cc_prebuilt_library_shared {
    name: "libMali",
    srcs: ["blobs/libMali.so"],
    vendor: true,
    compile_multilib: "32",
    strip: { none: true },
    check_elf_files: true,
    shared_libs: ["libutils", "libcutils", "libbinder", "libui", "libhardware", "liblog", "libstdc++", "libga36rt"],
    system_shared_libs: ["libc", "libdl", "libm"],
}
cc_prebuilt_library_shared {
    name: "libEGL_mali",
    srcs: ["blobs/libEGL_mali.so"],
    vendor: true,
    compile_multilib: "32",
    strip: { none: true },
    check_elf_files: true,
    shared_libs: ["libMali", "libstdc++"],
    system_shared_libs: ["libc", "libm"],
    relative_install_path: "egl",
}
cc_prebuilt_library_shared {
    name: "libGLESv1_CM_mali",
    srcs: ["blobs/libGLESv1_CM_mali.so"],
    vendor: true,
    compile_multilib: "32",
    strip: { none: true },
    check_elf_files: true,
    shared_libs: ["libMali", "libstdc++"],
    system_shared_libs: ["libc", "libm"],
    relative_install_path: "egl",
}
cc_prebuilt_library_shared {
    name: "libGLESv2_mali",
    srcs: ["blobs/libGLESv2_mali.so"],
    vendor: true,
    compile_multilib: "32",
    strip: { none: true },
    check_elf_files: true,
    shared_libs: ["libMali", "libstdc++"],
    system_shared_libs: ["libc", "libm"],
    relative_install_path: "egl",
}
cc_prebuilt_library_shared {
    name: "ga36_gralloc",
    srcs: ["blobs/gralloc.ga36.so"],
    vendor: true,
    compile_multilib: "32",
    strip: { none: true },
    check_elf_files: true,
    shared_libs: ["liblog", "libcutils", "libMali", "libGLESv1_CM", "libion", "libhardware", "libstdc++", "libga36rt"],
    system_shared_libs: ["libc", "libm"],
    relative_install_path: "hw",
    stem: "gralloc.ga36",
    overrides: ["gralloc.default"],
}
