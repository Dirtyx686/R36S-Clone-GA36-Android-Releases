+// Only the GA36 legacy framebuffer needs this BSP bridge.
+static bool isGa36Framebuffer() {
+    static const bool ga36 = [] {
+        char value[PROP_VALUE_MAX] = {};
+        __system_property_get("ro.hardware.gralloc", value);
+        return strcmp(value, "ga36") == 0;
+    }();
+    return ga36;
+}
+
+static int32_t setGa36FramebufferPower(int32_t mode) {
+    int blank;
+    if (mode == HWC2_POWER_MODE_OFF) blank = FB_BLANK_POWERDOWN;
+    else if (mode == HWC2_POWER_MODE_ON) blank = FB_BLANK_UNBLANK;
+    else return HWC2_ERROR_UNSUPPORTED;
+    int fd = open("/dev/graphics/fb0", O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return HWC2_ERROR_NO_RESOURCES;
+    struct stat st;
+    if (fstat(fd, &st) || !S_ISCHR(st.st_mode)) {
+        close(fd);
+        return HWC2_ERROR_NO_RESOURCES;
+    }
+    int result;
+    do { result = ioctl(fd, FBIOBLANK, blank); } while (result < 0 && errno == EINTR);
+    int saved = result < 0 ? errno : 0;
+    close(fd);
+    ALOGI("GA36_DISPLAY_POWER mode=%d blank=%d result=%d errno=%d", mode, blank, result, saved);
+    return result == 0 ? HWC2_ERROR_NONE : HWC2_ERROR_NO_RESOURCES;
+}
