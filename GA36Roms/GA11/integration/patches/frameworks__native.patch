+// The legacy VC renderer picks RGB565. Keep this workaround limited to
+// that process and an exact 565 window request; never lie about EGL config bits.
+static bool ga36GtaProcess() {
+    static const bool result = [] {
+        if (base::GetProperty("ro.hardware", "") != "ga36") return false;
+        char name[128] = {};
+        FILE* f = fopen("/proc/self/cmdline", "re");
+        if (!f) return false;
+        const size_t n = fread(name, 1, sizeof(name) - 1, f);
+        fclose(f);
+        const char* pkg = "com.rockstargames.gtavc";
+        const size_t len = strlen(pkg);
+        return n > len && !memcmp(name, pkg, len) &&
+                (name[len] == '\0' || name[len] == ':');
+    }();
+    return result;
+}
+
+static bool ga36PromoteGta565(const EGLint* attrs, bool eligible,
+                            std::vector<EGLint>& out) {
+    if (!eligible || !attrs) return false;
+    int red = -1, green = -1, blue = -1, alpha = 0;
+    int surface = EGL_WINDOW_BIT, color = EGL_RGB_BUFFER, id = 0;
+    size_t count = 0;
+    for (; count < 128 && attrs[count] != EGL_NONE; count += 2) {
+        const int key = attrs[count], value = attrs[count + 1];
+        switch (key) {
+            case EGL_RED_SIZE: if (red != -1) return false; red = value; break;
+            case EGL_GREEN_SIZE: if (green != -1) return false; green = value; break;
+            case EGL_BLUE_SIZE: if (blue != -1) return false; blue = value; break;
+            case EGL_ALPHA_SIZE: alpha = value; break;
+            case EGL_SURFACE_TYPE: surface = value; break;
+            case EGL_COLOR_BUFFER_TYPE: color = value; break;
+            case EGL_CONFIG_ID: id = value; break;
+            case EGL_COLOR_COMPONENT_TYPE_EXT:
+                if (value != EGL_COLOR_COMPONENT_TYPE_FIXED_EXT) return false;
+                break;
+        }
+    }
+    if (count >= 128 || red != 5 || green != 6 || blue != 5 || alpha != 0 ||
+        !(surface & EGL_WINDOW_BIT) || color != EGL_RGB_BUFFER || id > 0) return false;
+    out.assign(attrs, attrs + count + 1);
+    for (size_t i = 0; i < count; i += 2) {
+        if (out[i] == EGL_RED_SIZE || out[i] == EGL_GREEN_SIZE || out[i] == EGL_BLUE_SIZE)
+            out[i + 1] = 8;
+    }
+    return true;
+}
