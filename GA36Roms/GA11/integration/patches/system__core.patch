+
 #include <stdlib.h>
 #include <string.h>
 #include <stdint.h>
@@ -309,6 +311,32 @@ static void print_hid_descriptor(int bus, int vendor, int product)
     closedir(dir);
 }
 
+static int ga36_log;
+static unsigned ga36_keys_logged, ga36_axes_logged;
+static int ga36_values[4];
+static int64_t ga36_last_axis;
+static int ga36_axes_dirty;
+static void ga36_trace_event(const struct input_event* event) {
+    if (!ga36_log) return;
+    if (event->type == EV_ABS) {
+        int index = event->code == ABS_X ? 0 : event->code == ABS_Y ? 1 :
+                event->code == ABS_RX ? 2 : event->code == ABS_RY ? 3 : -1;
+        if (index >= 0) { ga36_values[index] = event->value; ga36_axes_dirty = 1; }
+    } else if (event->type == EV_KEY && ga36_keys_logged < 256) {
+        ++ga36_keys_logged;
+        __android_log_print(ANDROID_LOG_INFO, "GA36Raw", "KEY scan=%u value=%d",
+                            event->code, event->value);
+    } else if (event->type == EV_SYN && event->code == SYN_REPORT && ga36_axes_logged < 256) {
+        int64_t now = (int64_t)event->time.tv_sec * 1000000 + event->time.tv_usec;
+        if (ga36_axes_dirty && now - ga36_last_axis >= 200000) {
+            ga36_axes_dirty = 0;
+            ga36_last_axis = now; ++ga36_axes_logged;
+            __android_log_print(ANDROID_LOG_INFO, "GA36Raw", "AXES X=%d Y=%d Z=%d RZ=%d",
+                                ga36_values[0], ga36_values[1], ga36_values[2], ga36_values[3]);
+        }
+    }
+}
