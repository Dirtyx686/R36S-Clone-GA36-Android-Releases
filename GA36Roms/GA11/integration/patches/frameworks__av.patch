--- a/media/libstagefright/MediaCodecList.cpp
+++ b/media/libstagefright/MediaCodecList.cpp
@@ -97,7 +97,10 @@ std::vector<MediaCodecListBuilderBase *> GetBuilders() {
     std::vector<MediaCodecListBuilderBase *> builders;
     // if plugin provides the input surface, we cannot use OMX video encoders.
     // In this case, rely on plugin to provide list of OMX codecs that are usable.
-    sp<PersistentSurface> surfaceTest = CCodec::CreateInputSurface();
+    // A disabled Codec2 backend must not probe its graphic surfaces or enumerate
+    // its components. Legacy gralloc devices use the existing OMX software path.
+    const bool codec2Enabled = property_get_int32("debug.stagefright.ccodec", 4) != 0;
+    sp<PersistentSurface> surfaceTest = codec2Enabled ? CCodec::CreateInputSurface() : nullptr;
     if (surfaceTest == nullptr) {
         ALOGD("Allowing all OMX codecs");
         builders.push_back(&sOmxInfoBuilder);
@@ -105,7 +108,7 @@ std::vector<MediaCodecListBuilderBase *> GetBuilders() {
         ALOGD("Allowing only non-surface-encoder OMX codecs");
         builders.push_back(&sOmxNoSurfaceEncoderInfoBuilder);
     }
-    builders.push_back(GetCodec2InfoBuilder());
+    if (codec2Enabled) builders.push_back(GetCodec2InfoBuilder());
     return builders;
 }
 
